# Local LLM (Ollama) is used only to phrase explanations. All decisions are rule-based.
# Set LLM_PROVIDER=none to always use the fixed explanation templates.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=45
# PostgreSQL (created automatically if missing). Leave empty to keep data in memory.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/mortgage_uw
RISK_CONFIG_PATH=config/risk_config.yaml
AVNESTER_URL=https://api.avnester.com/public/v1/search_properties
